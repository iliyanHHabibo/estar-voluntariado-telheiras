# Copia este ficheiro para .env.local e preenche. O .env.local NUNCA vai para o GitHub.

# Supabase → Project Settings → API (ou "API Keys")
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Chave PÚBLICA: começa por "sb_publishable_" (ou a antiga "anon").
# NUNCA uses aqui a chave secreta ("sb_secret_" / "service_role").
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Opcional: Cloudflare Turnstile (anti-robôs no formulário de entrada).
# Se definires isto, ativa também o CAPTCHA no Supabase (Authentication → Attack Protection).
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...

# Só em produção, quando o site for público: deixar o Google indexar.
# NEXT_PUBLIC_INDEXAVEL=true

# ---- Emails do site (avisos de visitas, testemunhos novos, recolha aberta) ----
# Sem isto o site funciona na mesma, mas não envia emails.
# SMTP_USER=voluntariado.estar@gmail.com
# Palavra-passe de APLICAÇÃO do Google (16 letras, sem espaços) — nunca a palavra-passe normal.
# SMTP_PASSWORD=
# Opcional (por omissão: smtp.gmail.com e 587)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# Opcional: para onde vão os avisos à equipa (por omissão, a própria conta SMTP_USER)
# EMAIL_EQUIPA=voluntariado.estar@gmail.com
# Endereço do site, para os links dos emails (no teu PC: http://localhost:3000)
# SITE_URL=https://estar-voluntariado.vercel.app
